# ── PostgreSQL (default) ──
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5431
POSTGRES_USER=ainowork
POSTGRES_PASSWORD=Abc@1234
POSTGRES_DB=ainowork

# ── Optional: per-connection overrides ──
# DB_DEFAULT_MAX_ROWS=500
# DB_DEFAULT_POOL_SIZE=10
# DB_DEFAULT_POOL_OVERFLOW=20

# ── MySQL (uncomment to add a second connection) ──
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DB=mydb
# DB_MYSQL_MAX_ROWS=500

# ── Oracle (uncomment to add a third connection) ──
# ORACLE_HOST=127.0.0.1
# ORACLE_PORT=1521
# ORACLE_USER=scott
# ORACLE_PASSWORD=tiger
# ORACLE_SERVICE_NAME=XEPDB1

# ── Advanced: explicit SQLAlchemy URLs (overrides friendly vars above) ──
# DB_DEFAULT_URL=postgresql+asyncpg://user:pass@host:5432/mydb
# DB_ANALYTICS_URL=mysql+aiomysql://user:pass@host:3306/analytics
# DB_LEGACY_URL=oracle+oracledb://user:pass@host:1521/SERVICENAME
